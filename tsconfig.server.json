{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node", "vite/client", "vitest/globals"],
    "noEmit": true,
    "strict": true
  },
  "include": [
    "server/**/*.ts",
    "src/types/**/*.ts",
    "src/data/**/*.ts",
    "src/i18n/**/*.ts",
    "tests/server/**/*.ts",
    "vitest.server.config.ts"
  ]
}
