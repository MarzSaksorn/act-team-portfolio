# Runtime only. Copy to .env for local Compose, or set in Coolify's runtime secret store.
# Never commit populated secrets or expose these values through VITE_ variables.
PORT=3000
DATABASE_PATH=/data/act.sqlite
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
# 0 for direct local HTTP; set to the verified proxy hop count for Coolify.
TRUST_PROXY_HOPS=0
# Leave empty locally. Production, when configured, requires an HTTPS origin without a path.
PUBLIC_ORIGIN=

# Optional PUBLIC build-time welcome-area invite. Never use private tokens or channel details.
# Set via .env.local for static builds. Docker builds exclude all .env files.
VITE_DISCORD_INVITE_URL=
