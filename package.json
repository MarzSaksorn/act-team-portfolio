{
  "name": "act-team-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && tsc --project tsconfig.server.json --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/build-server.mjs && node scripts/prerender.mjs",
    "start": "node dist-server/server/index.js",
    "db:backup": "node dist-server/server/scripts/backup-database.js",
    "admin:hash": "node dist-server/server/scripts/create-admin-hash.js",
    "test:container": "node scripts/container-smoke.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest",
    "test:admin": "vitest run tests/admin-page.test.tsx",
    "test:static": "node --test tests/static-output.test.mjs",
    "test:e2e": "pnpm test:admin:e2e && pnpm test:e2e:public",
    "test:e2e:public": "playwright test --config=playwright.config.ts",
    "test:admin:e2e": "playwright test --config=playwright.admin.config.ts"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-thai": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "better-sqlite3": "13.2.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "lucide-react": "1.79.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@balena/dockerignore": "1.0.2",
    "@playwright/test": "1.65.1",
    "@redocly/cli": "2.82.0",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "jsdom": "31.0.1",
    "supertest": "7.3.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
